{
  "expo": {
    "name": "Glint",
    "slug": "glint-app",
    "version": "1.0.16",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glint",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.glinttechnologies.glint",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload photos to posts, stories and your profile",
        "NSCameraUsageDescription": "Take photos to share on Glint",
        "NSMicrophoneUsageDescription": "Record voice notes in chats"
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.glinttechnologies.glint",
      "permissions": [
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ],
      "versionCode": 16,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "glint-api-xf2i.onrender.com",
              "pathPrefix": "/share/profile/"
            },
            {
              "scheme": "https",
              "host": "glint-api-xf2i.onrender.com",
              "pathPrefix": "/share/post/"
            },
            {
              "scheme": "https",
              "host": "glint-api-xf2i.onrender.com",
              "pathPrefix": "/share/story/"
            },
            {
              "scheme": "https",
              "host": "glint-api-xf2i.onrender.com",
              "pathPrefix": "/share/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-iap",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "productionApiUrl": "https://glint-api-xf2i.onrender.com",
      "publicShareBaseUrl": "https://glint-api-xf2i.onrender.com"
    }
  }
}
